# Live build settings (npm run build). Public values only: everything here ends
# up inside the website's JavaScript. Never put a secret in a VITE_ variable.

# The shop: prices on the product pages, and the cart / Razorpay checkout.
VITE_SHOW_PRICES=true
VITE_CHECKOUT_ENABLED=true
VITE_SHOW_AMBASSADORS=true
# "Why Tamil Homes Trust Chennai Rice?" on the home page: off for now (shown locally only). true = show it.
VITE_SHOW_WHY=false

# Staff Google sign-in for /warehouse (Firebase web app of chennai-rice-website).
# Filled from: firebase apps:sdkconfig web --project chennai-rice-website
VITE_FIREBASE_API_KEY=AIzaSyDyMh8m-abNokZMmkF-0T7pDsAFcKwIPuo
VITE_FIREBASE_AUTH_DOMAIN=chennai-rice-website.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chennai-rice-website
VITE_FIREBASE_APP_ID=1:251127640817:web:01bd94d6a7ad1a9d126f50

# Google Ads: the Purchase conversion (Goals → Conversions → Purchase → Use Google Tag Manager).
# Sent with each paid order from /order-confirmed (googleAnalytics.js), only with analytics cookies accepted.
VITE_GOOGLE_ADS_ID=AW-18402321504
VITE_GOOGLE_ADS_PURCHASE_LABEL=zh16COf-q5sdEODI9MZE
