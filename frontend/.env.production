# Live build settings (npm run build). Public values only: everything here ends
# up inside the website's JavaScript. Never put a secret in a VITE_ variable.

# The shop: prices on the product pages, and the cart / Razorpay checkout.
VITE_SHOW_PRICES=true
VITE_CHECKOUT_ENABLED=true
VITE_SHOW_AMBASSADORS=true

