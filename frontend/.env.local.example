# Copy this file to .env.local and fill in real values. .env.local is
# gitignored (see .gitignore) — never commit real keys.
#
# These are the BROWSER-side Supabase vars. Vite only exposes env vars
# prefixed VITE_ to client code (see vite.config.js and src/lib/supabaseClient.js),
# so anything named VITE_* here ends up bundled into the shipped JS and is
# visible to anyone who opens devtools. That is expected and safe for the
# anon/publishable key below — it is meant to be public, and Row Level
# Security (RLS) policies in Postgres are what actually protect the data,
# not secrecy of this key.
#
# Project Settings -> API Keys, in the Supabase dashboard.
VITE_SUPABASE_URL=https://vsgfrqnmzhwhewuxxbij.supabase.co
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------------------------
# Do NOT put the service role key here. That key bypasses RLS and must only
# ever live server-side (see server/.env.example and api/_lib/supabase.js,
# which use plain SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY — no VITE_ prefix,
# so Vite never bundles them into browser code).
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Zoho Payments — the browser half of checkout. Both values are publishable by
# design: the widget API key and account id are meant to sit in browser code
# (Zoho's own sample embeds them in a script tag). The OAuth client secret and
# signing key are NOT here — they live server-side in server/.env.
#
# API key: Zoho Payments dashboard -> Settings -> Developer Space ->
#          Authentication Keys.
# Test mode defaults to true: it must be set to exactly "false" to take real
# money, so a missing or misspelt value can never charge a real card.
# --------------------------------------------------------------------------
VITE_ZOHO_PAYMENTS_ACCOUNT_ID=
VITE_ZOHO_PAYMENTS_API_KEY=
VITE_ZOHO_PAYMENTS_DOMAIN=IN
VITE_ZOHO_PAYMENTS_TEST_MODE=true

# --------------------------------------------------------------------------
# Feature switches.
#
# VITE_CHECKOUT_ENABLED gates online checkout and payment. It must be exactly
# "true" to open them; anything else (including unset, "1" or "yes") keeps
# /checkout on the Coming Soon page and the cart button saying so.
#
# Off by default on purpose: a deploy that forgets this shows "coming soon"
# rather than exposing a live payment flow before you meant to. None of the
# checkout code is removed when it is off — flip this to "true" to switch the
# whole flow back on.
# --------------------------------------------------------------------------
VITE_CHECKOUT_ENABLED=false
