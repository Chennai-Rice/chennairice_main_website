{
  "name": "chennai-rice-functions",
  "private": true,
  "description": "Firebase Cloud Function serving the /api routes from backend/server/app.js",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-functions --external:firebase-admin --external:pg --external:pg-native --external:@google-cloud/cloud-sql-connector",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "firebase-functions": "^6.1.1",
    "@google-cloud/cloud-sql-connector": "^1.4.0",
    "firebase-admin": "^12.7.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
