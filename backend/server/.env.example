GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
PORT=8787

# Cookie-consent audit log (optional in dev — without these the endpoint
# accepts consents but stores nothing). A Vercel KV / Upstash Redis
# integration provides both values.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase — required for /api/contact and /api/bulk-order to store enquiries.
# The service role key bypasses RLS, so it must never reach the browser or a
# public repo. Project Settings → API Keys, in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# Zoho Payments — required for guest checkout (api/checkout/*). Server-side
# only: the client secret and signing key must never reach the browser. The
# browser gets its own publishable pair, VITE_ZOHO_* in .env.local.example.
#
# account_id:    Zoho Payments dashboard -> Settings -> Account Details
#                (use the sandbox portal's id while testing).
# client id/secret + refresh token: register an ORG self-client at
#                https://api-console.zoho.in, grant scopes
#                ZohoPay.payments.CREATE and ZohoPay.payments.READ
#                (ZohoPaySandbox.* for sandbox), then exchange the auth code
#                for a refresh token. Refresh tokens do not expire.
# signing key:   Settings -> Developer Space -> Authentication Keys. Optional
#                but recommended — without it, widget signatures are not
#                verified and payments rest on the session re-fetch alone.
# domain:        IN | US | EU | AU — must match the data centre your account
#                lives in, or tokens and payments will not be found.
# --------------------------------------------------------------------------
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_PAYMENTS_SIGNING_KEY=
ZOHO_PAYMENTS_DOMAIN=IN
# Sandbox unless set to exactly "false". Sandbox is a separate environment on
# its own host (paymentssandbox.zoho.in) with its own account id, keys and
# ZohoPaySandbox.* scopes — nothing created there works live, and vice versa.
ZOHO_PAYMENTS_TEST_MODE=true
# Only set this if your OAuth client was registered with a redirect URI.
ZOHO_PAYMENTS_REDIRECT_URI=

# --------------------------------------------------------------------------
# Razorpay — the PRIMARY payment gateway. Server-side only: the key secret
# signs and authenticates every call and must never reach the browser. The
# key id is publishable and is handed to the browser per-session by
# api/_lib/checkout.js, so it needs no VITE_ counterpart.
#
# Dashboard -> Account & Settings -> API Keys -> Generate Test/Live Key.
# Test keys start "rzp_test_", live keys "rzp_live_" — the prefix is what
# decides test vs live, so there is no separate mode flag to get wrong.
# --------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --------------------------------------------------------------------------
# Gateway order. First name is tried first; the rest are fallbacks, used when
# a gateway is unconfigured, down, timing out or rate-limiting. A gateway left
# out of this list still goes to the back rather than being disabled — to turn
# one off, remove its credentials above.
#
# Failover happens only while creating a payment session, before the customer
# enters any card details. A declined card is never retried on the other
# gateway: that is the payment failing, not the gateway. See _lib/gateways.js.
# --------------------------------------------------------------------------
PAYMENT_GATEWAY_PRIORITY=razorpay,zoho_payments

# ---- Sales database (PostgreSQL / Cloud SQL) --------------------------------
# Set ONE of these and /api/checkout/* moves from Supabase to the sales backend.
# Local: run `npm run db:start` in backend/ and paste the URL it prints.
DATABASE_URL=
# Production (Cloud SQL), instead of DATABASE_URL:
# CLOUD_SQL_INSTANCE=chennairice-website:asia-south1:chennairice-db
# DB_NAME=chennairice
# DB_USER=chennairice_app
# DB_PASSWORD=            # from Secret Manager "db-app-password" — never commit
# DB_AUTH=iam             # alternative to a password: sign in as the service account

# Razorpay webhook secret (Dashboard → Webhooks). Lets payments complete even
# when the customer closes the tab before returning to the site.
RAZORPAY_WEBHOOK_SECRET=

# Staff admin API: first owner(s), bootstrapped on first sign-in (Firebase Auth).
OWNER_EMAILS=
FIREBASE_PROJECT_ID=chennai-rice-website

# Emails (Resend). Without these, mail waits in the email_outbox table.
RESEND_API_KEY=
EMAIL_FROM=Chennai Rice <orders@chennairiceindustries.com>
EMAIL_REPLY_TO=support@chennairiceindustries.com
SALES_NOTIFY_EMAIL=
INVENTORY_NOTIFY_EMAIL=

# Protects POST /api/jobs/run (the scheduled function calls the jobs directly).
JOB_TOKEN=
